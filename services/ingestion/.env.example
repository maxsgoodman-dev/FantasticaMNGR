# Warehouse sync (fantasy_ingest.warehouse). SUPABASE_SERVICE_ROLE_KEY
# bypasses row-level security — never commit a real value, never expose
# it to apps/web (which only ever uses the anon/publishable key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
